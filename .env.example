# MetaTrader 5 MCP Server Configuration Example
# Copy this file to .env and update with your credentials
# IMPORTANT: Never commit the .env file to version control!

# MT5 Trading Account Configuration
MT5_LOGIN=109555724
MT5_PASSWORD=P-6rToGt
MT5_SERVER=MetaQuotes-Demo
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Logging Configuration
LOG_LEVEL=ERROR
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Server Configuration
# MCP_SERVER_NAME=claude_dasktop_config.json
{
  "mcpServers": {
    "metatrader": {
      "command": "metatrader5-mcp",
      "args": [
        "--login", "YOUR_MT5_LOGIN",
        "--password", "YOUR_MT5_PASSWORD",
        "--server", "YOUR_MT5_SERVER",
        "--path", "C:\\Program Files\\MetaTrader 5\\terminal64.exe"
      ]
    }
  }
}
